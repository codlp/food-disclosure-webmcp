<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="{{ routes.root_url }}">
      <img
        class="brand__mark"
        src="{{ 'maple-sage-logo.png' | asset_url }}"
        alt=""
        width="48"
        height="48"
      >
      <span class="brand__text">
        <span class="site-title">{{ 'header.home' | t }}</span>
      </span>
    </a>
    <form class="search-bar" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="header-search">{{ 'search.label' | t }}</label>
      <input
        id="header-search"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
      >
      <button type="submit" class="visually-hidden">{{ 'search.submit' | t }}</button>
    </form>
    <nav aria-label="Primary">
      <a class="cart-link" href="{{ routes.cart_url }}">
        {{ 'header.cart' | t }}
        (<span id="cart-count">{{ cart.item_count }}</span>)
        · <span id="cart-total">{{ cart.total_price | money }}</span>
      </a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
