<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__identity">
      <p class="footer-brand">
        <img
          class="brand__mark"
          src="{{ 'maple-sage-logo.png' | asset_url }}"
          alt=""
          width="40"
          height="40"
        >
        <span class="brand-name">{{ 'header.home' | t }}</span>
      </p>
      <p class="site-footer__place">{{ 'footer.place' | t }}</p>
    </div>
    <div class="site-footer__hours">
      <p class="mono-kicker">{{ 'footer.hours_title' | t }}</p>
      <p class="site-footer__hours-row">
        <span>{{ 'footer.hours_weekdays' | t }}</span>
        <span>{{ 'footer.hours_weekdays_time' | t }}</span>
      </p>
      <p class="site-footer__hours-row">
        <span>{{ 'footer.hours_sunday' | t }}</span>
        <span>{{ 'footer.hours_sunday_time' | t }}</span>
      </p>
    </div>
    <div class="site-footer__note">
      <p class="mono-kicker">{{ 'footer.note_title' | t }}</p>
      <p class="site-footer__notice">{{ 'footer.notice' | t }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
