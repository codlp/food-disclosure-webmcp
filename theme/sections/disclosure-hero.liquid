<section class="hero">
  <div class="hero__photo">
    <img
      src="{{ 'maple-sage-shopfront.jpg' | asset_url }}"
      alt="{{ 'hero.photo_alt' | t }}"
      width="1600"
      height="1066"
    >
  </div>
  <div class="hero__inner">
    <div class="hero__copy">
      <h1>{{ 'hero.heading' | t }}</h1>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Disclosure hero",
  "settings": []
}
{% endschema %}
