<section id="assistants" class="assistants">
  <div class="assistants__inner">
    <div class="assistants__copy">
      <span class="mono-kicker">{{ 'assistants.kicker' | t }}</span>
      <h2>{{ 'assistants.heading' | t }}</h2>
      <p>{{ 'assistants.body' | t }}</p>
      <p class="hero__request-label">{{ 'hero.request_label' | t }}</p>
      <p id="demo-request-text">{{ 'hero.request' | t }}</p>
      <button
        type="button"
        class="button"
        id="copy-demo-request"
        data-label="{{ 'hero.copy' | t }}"
        data-copied-label="{{ 'hero.copied' | t }}"
        data-failed-label="{{ 'hero.copy_failed' | t }}"
      >
        {{ 'hero.copy' | t }}
      </button>
    </div>
    <div class="assistants__tools">
      <div class="tool-row">
        <span class="tool-name">search_catalog</span>
        <span>{{ 'assistants.search' | t }}</span>
      </div>
      <div class="tool-row">
        <span class="tool-name">get_product</span>
        <span>{{ 'assistants.get_product' | t }}</span>
      </div>
      <div class="tool-row">
        <span class="tool-name">get_product_food_disclosures</span>
        <span>{{ 'assistants.disclosures' | t }}</span>
      </div>
      <div class="tool-row">
        <span class="tool-name">update_cart</span>
        <span>{{ 'assistants.update_cart' | t }}</span>
      </div>
      <div class="tool-row">
        <span class="tool-name">get_cart</span>
        <span>{{ 'assistants.get_cart' | t }}</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Assistants",
  "settings": []
}
{% endschema %}
