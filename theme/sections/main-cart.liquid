{%- liquid
  assign shop_url = collections['food-disclosure-demo'].url | default: routes.root_url
  assign cart_total = cart.total_price | money
-%}
<section class="cart-page" id="cart-page">
  <div class="cart-page__top">
    <div class="cart-page__intro">
      <a class="cart-page__back" href="{{ shop_url }}">{{ 'cart.back' | t }}</a>
      <h1>{{ 'cart.heading' | t }}</h1>
    </div>
    {% if cart.item_count == 1 %}
      <span class="cart-page__summary">{{ 'cart.summary_one' | t }}</span>
    {% elsif cart.item_count > 1 %}
      <span class="cart-page__summary">{{ 'cart.summary_other' | t: count: cart.item_count }}</span>
    {% endif %}
  </div>

  {% if cart.item_count == 0 %}
    <div class="cart-empty">
      <p class="cart-empty__heading">{{ 'cart.empty_heading' | t }}</p>
      <p>{{ 'cart.empty' | t }}</p>
      <a class="button" href="{{ shop_url }}">{{ 'cart.start' | t }}</a>
    </div>
  {% else %}
    <div class="cart-layout">
      <div class="cart-lines">
        <div class="cart-lines__head">
          <span></span>
          <span>{{ 'cart.item' | t }}</span>
          <span>{{ 'cart.quantity' | t }}</span>
          <span>{{ 'cart.line' | t }}</span>
        </div>
        {% for item in cart.items %}
          <article class="cart-line">
            <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {% render 'product-art', product: item.product, width: 120, height: 120 %}
            </a>
            <div class="cart-line__copy">
              <div class="cart-line__title-row">
                <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                <button
                  type="button"
                  class="product-card__info"
                  data-disclosure-dialog="label-cart-{{ forloop.index }}"
                  aria-label="{{ 'product.label' | t }}"
                >
                  <span aria-hidden="true">i</span>
                </button>
              </div>
              <span class="cart-line__spec">{{ item.original_price | money }}</span>
              <a class="cart-line__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
              <dialog id="label-cart-{{ forloop.index }}">
                <div class="dialog__head">
                  <h2>{{ item.product.title }}</h2>
                  <button type="button" class="dialog-close" data-close-dialog aria-label="{{ 'product.close' | t }}">
                    <span aria-hidden="true">×</span>
                  </button>
                </div>
                {% render 'pack-label', product: item.product %}
              </dialog>
            </div>
            <div class="cart-line__qty">
              <a
                class="cart-line__step"
                href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ item.quantity | minus: 1 }}"
                aria-label="{{ 'cart.decrease' | t: title: item.product.title }}"
              >
                –
              </a>
              <span class="cart-line__count">{{ item.quantity }}</span>
              <a
                class="cart-line__step"
                href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ item.quantity | plus: 1 }}"
                data-cart-increase="{{ item.variant_id }}"
                aria-label="{{ 'cart.increase' | t: title: item.product.title }}"
              >
                +
              </a>
            </div>
            <span class="cart-line__price">{{ item.final_line_price | money }}</span>
          </article>
        {% endfor %}
      </div>

      <aside class="cart-order">
        <div class="cart-order__card">
          <span class="mono-kicker">{{ 'cart.order' | t }}</span>
          <div class="cart-order__rows">
            <div class="cart-order__row">
              {% if cart.item_count == 1 %}
                <span>{{ 'cart.items_one' | t }}</span>
              {% else %}
                <span>{{ 'cart.items_other' | t: count: cart.item_count }}</span>
              {% endif %}
              <span>{{ cart_total }}</span>
            </div>
            <div class="cart-order__row cart-order__row--total">
              <span>{{ 'cart.total' | t }}</span>
              <span>{{ cart_total }}</span>
            </div>
          </div>
          <details class="cart-order__demo">
            <summary class="button cart-order__place">
              {{ 'cart.place' | t: total: cart_total }}
            </summary>
            <p class="cart-order__receipt">{{ 'cart.place_notice' | t }}</p>
          </details>
        </div>
      </aside>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
