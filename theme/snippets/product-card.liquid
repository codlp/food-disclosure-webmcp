{% doc %}
Renders a product card with human add controls and a label dialog.
@param {product} product - The product to render
{% enddoc %}
<article class="product-card">
  <a href="{{ product.url }}">
    <div class="product-card__media">
      {% render 'product-art', product: product, width: 640, height: 400 %}
    </div>
    <h2>{{ product.title }}</h2>
  </a>
  <p>{{ product.description | strip_html | truncate: 140 }}</p>
  {% render 'price', product: product %}
  <div class="product-card__actions">
    {% form 'product', product %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" name="add" class="button">{{ 'product.add' | t }}</button>
    {% endform %}
    <button type="button" class="button button-secondary" data-disclosure-dialog="label-{{ product.id }}">
      {{ 'product.label' | t }}
    </button>
  </div>
  <dialog id="label-{{ product.id }}">
    <h2>{{ product.title }}</h2>
    <p>
      <strong>Ingredients:</strong>
      {% if product.metafields.custom.ingredients.type == 'multi_line_text_field' %}
        {{ product.metafields.custom.ingredients.value }}
      {% else %}
        Not supplied
      {% endif %}
    </p>
    <p>
      <strong>Label statements:</strong>
      {% if product.metafields.custom.label_statements.type == 'json' %}
        {% if product.metafields.custom.label_statements.value.size == 0 %}
          No separate label statement in the supplied demo record
        {% else %}
          {% for statement in product.metafields.custom.label_statements.value %}
            {{ statement }}
          {% endfor %}
        {% endif %}
      {% else %}
        Not supplied
      {% endif %}
    </p>
    <p>{{ 'review.disclaimer' | t }}</p>
    <button type="button" class="button" data-close-dialog>{{ 'product.close' | t }}</button>
  </dialog>
</article>
