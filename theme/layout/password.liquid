<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'header.home' | t }}</title>
    {% render 'favicon' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="password-page">
    <a class="skip-link" href="#main-content">{{ 'accessibility.skip' | t }}</a>
    <main id="main-content" class="password-card">
      <img
        class="brand__mark"
        src="{{ 'maple-sage-logo.png' | asset_url }}"
        alt=""
        width="56"
        height="56"
      >
      <h1>{{ 'password.heading' | t }}</h1>
      <p>{{ 'password.body' | t }}</p>
      {% form 'storefront_password' %}
        <label for="password">{{ 'password.label' | t }}</label>
        <input id="password" type="password" name="password" autocomplete="current-password">
        <button type="submit" class="button">{{ 'password.submit' | t }}</button>
      {% endform %}
      {{ content_for_layout }}
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__note">
          <p class="mono-kicker">{{ 'footer.note_title' | t }}</p>
          <p class="site-footer__notice">{{ 'footer.notice' | t }}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
