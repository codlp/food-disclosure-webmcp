<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="password-page">
    <a class="skip-link" href="#main-content">{{ 'accessibility.skip' | t }}</a>
    <main id="main-content" class="password-card">
      <h1>{{ 'password.heading' | t }}</h1>
      <p>{{ 'password.body' | t }}</p>
      {% form 'storefront_password' %}
        <label for="password">{{ 'password.label' | t }}</label>
        <input id="password" type="password" name="password" autocomplete="current-password">
        <button type="submit" class="button">{{ 'password.submit' | t }}</button>
      {% endform %}
      {{ content_for_layout }}
    </main>
    <footer class="site-footer">
      <p>{{ 'footer.notice' | t }}</p>
    </footer>
  </body>
</html>
