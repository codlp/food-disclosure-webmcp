{
  "name": "label-check",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Label Check: a grocery storefront where an agent must retrieve ingredients and label statements before it can add to the cart.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:webmcp": "node scripts/webmcp-chrome-slice.mjs",
    "theme:check": "npx --yes @shopify/cli@4.7.0 theme check --path theme"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
